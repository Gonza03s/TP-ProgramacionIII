<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<body class="body-login">
    <main class="main-login">

        <section>
            <% if (typeof error !== "undefined") { %>
                <p class="mensaje error centrado"> <%= error %> </p>
            <% } %>
        </section>

        <section class="login-section-container">

            <div class="login-content">
                <h2> <%= about %> </h2>
                    <form id="login-form" action="/login" method="POST" >
                        
                        <label for="emailUser"></label>
                        <input class="input-style" type="email" name="email" id="emailUser" required placeholder="Email">

                        <label for="passwordUser"></label>
                        <input class="input-style" type="password" name="password" id="passwordUser" required placeholder="Contraseña">

                        <input class="btn-enviar" type="submit" value="Login">

                    </form>
            </div>
        </section>
    
    </main>
</body>

