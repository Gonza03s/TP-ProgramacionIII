<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>


<section class="forms-post-section-container">
    
    <div id="mensajes">
        <% if (typeof exito !== "undefined") { %>
            <p class="mensaje exito centrado"> <%= exito %> </p>
        <% } %>
    
        <% if (typeof error !== "undefined") { %>
            <p class="mensaje error centrado"> <%= error %> </p>
        <% } %>
    </div>
    
        <div id="contenedor-producto"></div>


        <div class="forms-post-content">

            <section class="form-section">

                <div class="form-container">
                    
                    <h2>Crear Producto</h2>

                    <form id="form-post">

                        <label for="categoryProd">Categoria</label>
                        <select class="input-style" name="category" id="categoryProd" required>
                            <option value="medications">medicamento</option>
                            <option value="sports supplements">suplemento deportivo</option>
                        </select>

                        <label for="image-prod">Imagen</label>
                        <input class="input-style" type="text" name="image" id="image-prod" required>

                        <label for="name-prod">Nombre</label>
                        <input class="input-style" type="text" name="name" id="name-prod" required>
                
                        <label for="price-prod">Precio</label>
                        <input class="input-style" type="number" name="price" id="price-prod" required>
                
                        <input class="btn-enviar" type="submit" value="Crear Producto">
                    </form>
                </div>
                
                <section id="contenedor-productos"></section>


            </section>

            <section class="createUser-container form-container ">

                <h3> Crear usuario admin </h3>

                <form id="createUserForm" action="/api/users" method="POST">

                    <label for="nameUser">Nombre</label>
                    <input class="input-style" type="text" name="name" id="nameUser" required>

                    <label for="emailUser">Email</label>
                    <input class="input-style" type="email" name="email" id="emailUser" required>

                    <label for="passwordUser">Password</label>
                    <input class="input-style" type="password" name="password" id="passwordUser" required>

                    <input class="btn-enviar" type="submit" value="Crear admin">

                </form>
            </section>

        </div>

    </section>


    <script src="/js/post.js"></script>
  </body>
</html>
